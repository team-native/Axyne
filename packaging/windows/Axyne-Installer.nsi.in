Unicode True
ManifestDPIAware True
XPStyle on

Name "Axyne"
Caption "Install Axyne"
OutFile "@AXYNE_WINDOWS_INSTALLER_OUTPUT@"
InstallDir "$LOCALAPPDATA\Programs\Axyne"
InstallDirRegKey HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Axyne" "InstallLocation"
RequestExecutionLevel user
ShowInstDetails show
AutoCloseWindow false

!include "MUI2.nsh"
!include "nsDialogs.nsh"
!include "LogicLib.nsh"

!define AXYNE_BG "131417"
!define AXYNE_SURFACE "1C1E22"
!define AXYNE_BORDER "2A2D33"
!define AXYNE_TEXT "D5D8DD"
!define AXYNE_MUTED "969BA5"
!define AXYNE_ACCENT "A667E8"
!define AXYNE_ACCENT_DARK "7B22B7"

Var AxynePage
Var AxynePathText
Var AxyneBrowseButton
Var AxyneLaunchCheckbox
Var AxyneInstallPath

!define MUI_ABORTWARNING
!define MUI_ICON "@CMAKE_CURRENT_SOURCE_DIR@\packaging\windows\Axyne.ico"
!define MUI_BGCOLOR "${AXYNE_BG}"
!define MUI_TEXTCOLOR "${AXYNE_TEXT}"
!define MUI_HEADERIMAGE
!define MUI_HEADERIMAGE_RIGHT
!define MUI_WELCOMEPAGE_TITLE "Install Axyne"
!define MUI_WELCOMEPAGE_TEXT "A fast, native development environment for Windows."
!define MUI_FINISHPAGE_TITLE "Axyne is ready"
!define MUI_FINISHPAGE_TEXT "Axyne has been installed on your computer."

Page custom AxyneWelcomePage AxyneWelcomeLeave
Page custom AxyneDirectoryPage AxyneDirectoryLeave
!insertmacro MUI_PAGE_INSTFILES
Page custom AxyneFinishPage AxyneFinishLeave

!insertmacro MUI_LANGUAGE "English"
!insertmacro MUI_LANGUAGE "Korean"

Function AxyneStyleWizardChrome
    SetCtlColors $HWNDPARENT "${AXYNE_TEXT}" "${AXYNE_BG}"
    GetDlgItem $0 $HWNDPARENT 1
    SetCtlColors $0 "FFFFFF" "${AXYNE_ACCENT_DARK}"
    GetDlgItem $0 $HWNDPARENT 2
    SetCtlColors $0 "${AXYNE_TEXT}" "${AXYNE_SURFACE}"
    GetDlgItem $0 $HWNDPARENT 3
    SetCtlColors $0 "${AXYNE_TEXT}" "${AXYNE_SURFACE}"
FunctionEnd

Function AxyneWelcomePage
    nsDialogs::Create 1044
    Pop $AxynePage
    ${If} $AxynePage == error
        Abort
    ${EndIf}
    Call AxyneStyleWizardChrome
    SetCtlColors $AxynePage "${AXYNE_TEXT}" "${AXYNE_BG}"

    ${NSD_CreateLabel} 24u 24u 330u 28u "Axyne"
    Pop $0
    CreateFont $1 "Segoe UI" 18 700
    SendMessage $0 ${WM_SETFONT} $1 0
    SetCtlColors $0 "FFFFFF" "${AXYNE_BG}"

    ${NSD_CreateLabel} 24u 58u 330u 18u "Native development, thoughtfully designed."
    Pop $0
    SetCtlColors $0 "${AXYNE_ACCENT}" "${AXYNE_BG}"

    ${NSD_CreateLabel} 24u 94u 360u 42u "This wizard will install Axyne for Windows and create a Start Menu shortcut."
    Pop $0
    SetCtlColors $0 "${AXYNE_TEXT}" "${AXYNE_BG}"

    ${NSD_CreateLabel} 24u 158u 360u 1u ""
    Pop $0
    SetCtlColors $0 "${AXYNE_ACCENT}" "${AXYNE_ACCENT}"

    ${NSD_CreateLabel} 24u 176u 360u 18u "Version @PROJECT_VERSION@  ·  Windows x64"
    Pop $0
    SetCtlColors $0 "${AXYNE_MUTED}" "${AXYNE_BG}"
    nsDialogs::Show
FunctionEnd

Function AxyneWelcomeLeave
FunctionEnd

Function AxyneDirectoryPage
    nsDialogs::Create 1018
    Pop $AxynePage
    ${If} $AxynePage == error
        Abort
    ${EndIf}
    Call AxyneStyleWizardChrome
    SetCtlColors $AxynePage "${AXYNE_TEXT}" "${AXYNE_BG}"

    ${NSD_CreateLabel} 24u 24u 360u 24u "Choose install location"
    Pop $0
    CreateFont $1 "Segoe UI" 13 600
    SendMessage $0 ${WM_SETFONT} $1 0
    SetCtlColors $0 "FFFFFF" "${AXYNE_BG}"

    ${NSD_CreateLabel} 24u 62u 360u 18u "Axyne will be installed in the following folder."
    Pop $0
    SetCtlColors $0 "${AXYNE_MUTED}" "${AXYNE_BG}"

    ${NSD_CreateText} 24u 94u 282u 20u "$INSTDIR"
    Pop $AxynePathText
    SetCtlColors $AxynePathText "${AXYNE_TEXT}" "${AXYNE_SURFACE}"

    ${NSD_CreateButton} 314u 94u 70u 20u "Browse..."
    Pop $AxyneBrowseButton
    SetCtlColors $AxyneBrowseButton "FFFFFF" "${AXYNE_ACCENT_DARK}"
    ${NSD_OnClick} $AxyneBrowseButton AxyneBrowseForFolder

    ${NSD_CreateLabel} 24u 136u 360u 36u "You can change this location later from Windows Apps & features."
    Pop $0
    SetCtlColors $0 "${AXYNE_MUTED}" "${AXYNE_BG}"
    nsDialogs::Show
FunctionEnd

Function AxyneBrowseForFolder
    nsDialogs::SelectFolderDialog "Select Axyne install folder" $INSTDIR
    Pop $0
    ${If} $0 != error
        ${If} $0 != ""
            StrCpy $INSTDIR $0
            ${NSD_SetText} $AxynePathText $INSTDIR
        ${EndIf}
    ${EndIf}
FunctionEnd

Function AxyneDirectoryLeave
    ${NSD_GetText} $AxynePathText $AxyneInstallPath
    StrCpy $INSTDIR $AxyneInstallPath
FunctionEnd

Function AxyneFinishPage
    nsDialogs::Create 1018
    Pop $AxynePage
    ${If} $AxynePage == error
        Abort
    ${EndIf}
    Call AxyneStyleWizardChrome
    SetCtlColors $AxynePage "${AXYNE_TEXT}" "${AXYNE_BG}"

    ${NSD_CreateLabel} 24u 34u 360u 28u "Axyne is ready to use"
    Pop $0
    CreateFont $1 "Segoe UI" 15 600
    SendMessage $0 ${WM_SETFONT} $1 0
    SetCtlColors $0 "FFFFFF" "${AXYNE_BG}"

    ${NSD_CreateLabel} 24u 76u 360u 36u "Thank you for installing Axyne. Start coding with a clean, native workspace."
    Pop $0
    SetCtlColors $0 "${AXYNE_TEXT}" "${AXYNE_BG}"

    ${NSD_CreateCheckbox} 24u 136u 300u 18u "Launch Axyne now"
    Pop $AxyneLaunchCheckbox
    SetCtlColors $AxyneLaunchCheckbox "${AXYNE_TEXT}" "${AXYNE_BG}"
    ${NSD_Check} $AxyneLaunchCheckbox
    nsDialogs::Show
FunctionEnd

Function AxyneFinishLeave
    ${NSD_GetState} $AxyneLaunchCheckbox $0
    ${If} $0 == ${BST_CHECKED}
        ExecShell "open" "$INSTDIR\axyne.exe"
    ${EndIf}
FunctionEnd

Section "Axyne" SecAxyne
    SectionIn RO
    SetOutPath "$INSTDIR"
    File "@CMAKE_CURRENT_BINARY_DIR@\axyne.exe"
    File "@CMAKE_CURRENT_BINARY_DIR@\Scintilla.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@\Lexilla.dll"
@AXYNE_MSVC_RUNTIME_NSIS_FILES@
    File "@CMAKE_CURRENT_BINARY_DIR@\version.json"
    File "@CMAKE_CURRENT_BINARY_DIR@\Scintilla-LICENSE.txt"
    File "@CMAKE_CURRENT_BINARY_DIR@\Lexilla-LICENSE.txt"
    File "@CMAKE_CURRENT_SOURCE_DIR@\LICENSE"
    File "@CMAKE_CURRENT_SOURCE_DIR@\docs\RELEASE_NOTES.md"

    CreateDirectory "$SMPROGRAMS\Axyne"
    CreateShortcut "$SMPROGRAMS\Axyne\Axyne.lnk" "$INSTDIR\axyne.exe"
    CreateShortcut "$DESKTOP\Axyne.lnk" "$INSTDIR\axyne.exe"
    WriteUninstaller "$INSTDIR\Uninstall.exe"
    WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Axyne" "DisplayName" "Axyne"
    WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Axyne" "DisplayVersion" "@PROJECT_VERSION@"
    WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Axyne" "InstallLocation" "$INSTDIR"
    WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Axyne" "UninstallString" "$INSTDIR\Uninstall.exe"
SectionEnd

Section "Uninstall"
    Delete "$SMPROGRAMS\Axyne\Axyne.lnk"
    RMDir "$SMPROGRAMS\Axyne"
    Delete "$DESKTOP\Axyne.lnk"
    Delete "$INSTDIR\*.*"
    DeleteRegKey HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Axyne"
    RMDir "$INSTDIR"
SectionEnd
