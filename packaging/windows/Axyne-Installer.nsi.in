Unicode True
ManifestDPIAware True
XPStyle on

Name "Axyne"
Caption "Install Axyne"
OutFile "@AXYNE_WINDOWS_INSTALLER_BACKEND@"
InstallDir "$LOCALAPPDATA\Programs\Axyne"
InstallDirRegKey HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Axyne" "InstallLocation"
RequestExecutionLevel user
ShowInstDetails show
AutoCloseWindow false

!include "MUI2.nsh"
!include "nsDialogs.nsh"
!include "LogicLib.nsh"
!include "FileFunc.nsh"

!define AXYNE_UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\Axyne"

!define AXYNE_BG "131417"
!define AXYNE_SURFACE "1C1E22"
!define AXYNE_BORDER "2A2D33"
!define AXYNE_TEXT "D5D8DD"
!define AXYNE_MUTED "969BA5"
!define AXYNE_ACCENT "A667E8"
!define AXYNE_ACCENT_DARK "7B22B7"

Var AxynePage
Var AxynePathText
Var AxyneBrowseButton
Var AxyneLaunchCheckbox
Var AxyneInstallPath
Var AxyneJournal
Var AxyneBackupCount
Var AxyneStartMenu
Var AxyneDesktop
Var AxyneScopeArg

!define MUI_ABORTWARNING
!define MUI_ICON "@CMAKE_CURRENT_SOURCE_DIR@\packaging\windows\Axyne.ico"
!define MUI_BGCOLOR "${AXYNE_BG}"
!define MUI_TEXTCOLOR "${AXYNE_TEXT}"
!define MUI_HEADERIMAGE
!define MUI_HEADERIMAGE_RIGHT
!define MUI_WELCOMEPAGE_TITLE "Install Axyne"
!define MUI_WELCOMEPAGE_TEXT "A fast, native development environment for Windows."
!define MUI_FINISHPAGE_TITLE "Axyne is ready"
!define MUI_FINISHPAGE_TEXT "Axyne has been installed on your computer."

Page custom AxyneWelcomePage AxyneWelcomeLeave
Page custom AxyneDirectoryPage AxyneDirectoryLeave
!insertmacro MUI_PAGE_INSTFILES
Page custom AxyneFinishPage AxyneFinishLeave

!insertmacro MUI_LANGUAGE "English"
!insertmacro MUI_LANGUAGE "Korean"

; Command line used by the custom installer UI (installer_ui.c):
;   /S [/ALLUSERS] [/NOSTARTMENU] [/NODESKTOP] [/JOURNAL="<file>"] /D=<dir>
; /ALLUSERS switches $SMPROGRAMS/$DESKTOP and SHCTX to the all-users locations
; (HKLM); the UI only passes it from an elevated process. Without /JOURNAL the
; backend behaves as before (no backups, no journal).
Function .onInit
    SetRegView 64
    StrCpy $AxyneStartMenu 1
    StrCpy $AxyneDesktop 1
    StrCpy $AxyneJournal ""
    StrCpy $AxyneBackupCount 0
    ; Passed to Uninstall.exe through UninstallString so the uninstaller knows
    ; which registry hive (HKLM or HKCU) it was started for.
    StrCpy $AxyneScopeArg "/CURRENTUSER"
    ${GetParameters} $R0
    ClearErrors
    ${GetOptions} $R0 "/ALLUSERS" $R1
    ${IfNot} ${Errors}
        SetShellVarContext all
        StrCpy $AxyneScopeArg "/ALLUSERS"
    ${EndIf}
    ClearErrors
    ${GetOptions} $R0 "/NOSTARTMENU" $R1
    ${IfNot} ${Errors}
        StrCpy $AxyneStartMenu 0
    ${EndIf}
    ClearErrors
    ${GetOptions} $R0 "/NODESKTOP" $R1
    ${IfNot} ${Errors}
        StrCpy $AxyneDesktop 0
    ${EndIf}
    ClearErrors
    ${GetOptions} $R0 "/JOURNAL=" $R1
    ${IfNot} ${Errors}
        StrCpy $AxyneJournal $R1
    ${EndIf}
FunctionEnd

; Appends one UTF-16LE line to the rollback journal. The line is written
; before the matching change is made, so a killed backend never leaves an
; unrecorded change behind. If the journal cannot be written the install is
; aborted rather than continuing without a rollback record.
Function AxyneJournalWrite
    Exch $R9
    Push $R8
    Push $R7
    ${If} $AxyneJournal != ""
        StrCpy $R7 0
        ${Do}
            ClearErrors
            FileOpen $R8 $AxyneJournal a
            ${IfNot} ${Errors}
                ${Break}
            ${EndIf}
            IntOp $R7 $R7 + 1
            ${If} $R7 >= 40
                Abort
            ${EndIf}
            Sleep 50
        ${Loop}
        FileSeek $R8 0 END
        FileWriteUTF16LE $R8 "$R9$\r$\n"
        FileClose $R8
    ${EndIf}
    Pop $R7
    Pop $R8
    Pop $R9
FunctionEnd

!macro AxyneJournal LINE
    Push `${LINE}`
    Call AxyneJournalWrite
!macroend

; Records a file about to be written. A new file gets "N<TAB>path". An
; existing file is moved into $INSTDIR\.axyne-backup first: "M<TAB>path<TAB>bak"
; is written before the move (intent) and "B<TAB>path<TAB>bak" only after the
; move succeeded, so a rollback never restores an unconfirmed or stale backup
; over the current file. A stale backup that cannot be removed, or a file that
; cannot be moved, aborts the install before anything is changed.
Function AxyneBeforeWrite
    Exch $R0
    Push $R1
    ${If} $AxyneJournal != ""
        ${If} ${FileExists} "$R0"
            IntOp $AxyneBackupCount $AxyneBackupCount + 1
            StrCpy $R1 "$INSTDIR\.axyne-backup\$AxyneBackupCount.bak"
            CreateDirectory "$INSTDIR\.axyne-backup"
            ${If} ${FileExists} "$R1"
                Delete "$R1"
                ${If} ${FileExists} "$R1"
                    Abort
                ${EndIf}
            ${EndIf}
            !insertmacro AxyneJournal "M$\t$R0$\t$R1"
            ClearErrors
            Rename "$R0" "$R1"
            ${If} ${Errors}
                Abort
            ${EndIf}
            !insertmacro AxyneJournal "B$\t$R0$\t$R1"
        ${Else}
            !insertmacro AxyneJournal "N$\t$R0"
        ${EndIf}
    ${EndIf}
    Pop $R1
    Pop $R0
FunctionEnd

!macro AxyneFile SOURCE NAME
    Push "$INSTDIR\${NAME}"
    Call AxyneBeforeWrite
    File "/oname=${NAME}" "${SOURCE}"
!macroend

; Records the previous value of an uninstall-key value ("V<TAB>name<TAB>old")
; before it is overwritten.
!macro AxyneRegValue NAME VALUE
    ClearErrors
    ReadRegStr $R1 SHCTX "${AXYNE_UNINSTALL_KEY}" "${NAME}"
    !insertmacro AxyneJournal "V$\t${NAME}$\t$R1"
    WriteRegStr SHCTX "${AXYNE_UNINSTALL_KEY}" "${NAME}" "${VALUE}"
!macroend

Function AxyneStyleWizardChrome
    SetCtlColors $HWNDPARENT "${AXYNE_TEXT}" "${AXYNE_BG}"
    GetDlgItem $0 $HWNDPARENT 1
    SetCtlColors $0 "FFFFFF" "${AXYNE_ACCENT_DARK}"
    GetDlgItem $0 $HWNDPARENT 2
    SetCtlColors $0 "${AXYNE_TEXT}" "${AXYNE_SURFACE}"
    GetDlgItem $0 $HWNDPARENT 3
    SetCtlColors $0 "${AXYNE_TEXT}" "${AXYNE_SURFACE}"
FunctionEnd

Function AxyneWelcomePage
    nsDialogs::Create 1044
    Pop $AxynePage
    ${If} $AxynePage == error
        Abort
    ${EndIf}
    Call AxyneStyleWizardChrome
    SetCtlColors $AxynePage "${AXYNE_TEXT}" "${AXYNE_BG}"

    ${NSD_CreateLabel} 24u 24u 330u 28u "Axyne"
    Pop $0
    CreateFont $1 "Segoe UI" 18 700
    SendMessage $0 ${WM_SETFONT} $1 0
    SetCtlColors $0 "FFFFFF" "${AXYNE_BG}"

    ${NSD_CreateLabel} 24u 58u 330u 18u "Native development, thoughtfully designed."
    Pop $0
    SetCtlColors $0 "${AXYNE_ACCENT}" "${AXYNE_BG}"

    ${NSD_CreateLabel} 24u 94u 360u 42u "This wizard will install Axyne for Windows and create a Start Menu shortcut."
    Pop $0
    SetCtlColors $0 "${AXYNE_TEXT}" "${AXYNE_BG}"

    ${NSD_CreateLabel} 24u 158u 360u 1u ""
    Pop $0
    SetCtlColors $0 "${AXYNE_ACCENT}" "${AXYNE_ACCENT}"

    ${NSD_CreateLabel} 24u 176u 360u 18u "Version @PROJECT_VERSION@  ·  Windows x64"
    Pop $0
    SetCtlColors $0 "${AXYNE_MUTED}" "${AXYNE_BG}"
    nsDialogs::Show
FunctionEnd

Function AxyneWelcomeLeave
FunctionEnd

Function AxyneDirectoryPage
    nsDialogs::Create 1018
    Pop $AxynePage
    ${If} $AxynePage == error
        Abort
    ${EndIf}
    Call AxyneStyleWizardChrome
    SetCtlColors $AxynePage "${AXYNE_TEXT}" "${AXYNE_BG}"

    ${NSD_CreateLabel} 24u 24u 360u 24u "Choose install location"
    Pop $0
    CreateFont $1 "Segoe UI" 13 600
    SendMessage $0 ${WM_SETFONT} $1 0
    SetCtlColors $0 "FFFFFF" "${AXYNE_BG}"

    ${NSD_CreateLabel} 24u 62u 360u 18u "Axyne will be installed in the following folder."
    Pop $0
    SetCtlColors $0 "${AXYNE_MUTED}" "${AXYNE_BG}"

    ${NSD_CreateText} 24u 94u 282u 20u "$INSTDIR"
    Pop $AxynePathText
    SetCtlColors $AxynePathText "${AXYNE_TEXT}" "${AXYNE_SURFACE}"

    ${NSD_CreateButton} 314u 94u 70u 20u "Browse..."
    Pop $AxyneBrowseButton
    SetCtlColors $AxyneBrowseButton "FFFFFF" "${AXYNE_ACCENT_DARK}"
    ${NSD_OnClick} $AxyneBrowseButton AxyneBrowseForFolder

    ${NSD_CreateLabel} 24u 136u 360u 36u "You can change this location later from Windows Apps & features."
    Pop $0
    SetCtlColors $0 "${AXYNE_MUTED}" "${AXYNE_BG}"
    nsDialogs::Show
FunctionEnd

Function AxyneBrowseForFolder
    nsDialogs::SelectFolderDialog "Select Axyne install folder" $INSTDIR
    Pop $0
    ${If} $0 != error
        ${If} $0 != ""
            StrCpy $INSTDIR $0
            ${NSD_SetText} $AxynePathText $INSTDIR
        ${EndIf}
    ${EndIf}
FunctionEnd

Function AxyneDirectoryLeave
    ${NSD_GetText} $AxynePathText $AxyneInstallPath
    StrCpy $INSTDIR $AxyneInstallPath
FunctionEnd

Function AxyneFinishPage
    nsDialogs::Create 1018
    Pop $AxynePage
    ${If} $AxynePage == error
        Abort
    ${EndIf}
    Call AxyneStyleWizardChrome
    SetCtlColors $AxynePage "${AXYNE_TEXT}" "${AXYNE_BG}"

    ${NSD_CreateLabel} 24u 34u 360u 28u "Axyne is ready to use"
    Pop $0
    CreateFont $1 "Segoe UI" 15 600
    SendMessage $0 ${WM_SETFONT} $1 0
    SetCtlColors $0 "FFFFFF" "${AXYNE_BG}"

    ${NSD_CreateLabel} 24u 76u 360u 36u "Thank you for installing Axyne. Start coding with a clean, native workspace."
    Pop $0
    SetCtlColors $0 "${AXYNE_TEXT}" "${AXYNE_BG}"

    ${NSD_CreateCheckbox} 24u 136u 300u 18u "Launch Axyne now"
    Pop $AxyneLaunchCheckbox
    SetCtlColors $AxyneLaunchCheckbox "${AXYNE_TEXT}" "${AXYNE_BG}"
    ${NSD_Check} $AxyneLaunchCheckbox
    nsDialogs::Show
FunctionEnd

Function AxyneFinishLeave
    ${NSD_GetState} $AxyneLaunchCheckbox $0
    ${If} $0 == ${BST_CHECKED}
        ExecShell "open" "$INSTDIR\axyne.exe"
    ${EndIf}
FunctionEnd

Section "Axyne" SecAxyne
    SectionIn RO
    SetOutPath "$INSTDIR"
    ; Total payload size in KiB (compiler-computed), used by the UI for
    ; byte-based progress. Index 0 is this section, the only install section.
    SectionGetSize 0 $R0
    !insertmacro AxyneJournal "T$\t$R0"
    !insertmacro AxyneFile "@CMAKE_CURRENT_BINARY_DIR@\axyne.exe" "axyne.exe"
    !insertmacro AxyneFile "@CMAKE_CURRENT_BINARY_DIR@\Scintilla.dll" "Scintilla.dll"
    !insertmacro AxyneFile "@CMAKE_CURRENT_BINARY_DIR@\Lexilla.dll" "Lexilla.dll"
@AXYNE_MSVC_RUNTIME_NSIS_FILES@
    !insertmacro AxyneFile "@CMAKE_CURRENT_BINARY_DIR@\version.json" "version.json"
    !insertmacro AxyneFile "@CMAKE_CURRENT_BINARY_DIR@\Scintilla-LICENSE.txt" "Scintilla-LICENSE.txt"
    !insertmacro AxyneFile "@CMAKE_CURRENT_BINARY_DIR@\Lexilla-LICENSE.txt" "Lexilla-LICENSE.txt"
    !insertmacro AxyneFile "@CMAKE_CURRENT_SOURCE_DIR@\LICENSE" "LICENSE"
    !insertmacro AxyneFile "@CMAKE_CURRENT_SOURCE_DIR@\docs\RELEASE_NOTES.md" "RELEASE_NOTES.md"

    ${If} $AxyneStartMenu == 1
        ${IfNot} ${FileExists} "$SMPROGRAMS\Axyne\*.*"
            !insertmacro AxyneJournal "D$\t$SMPROGRAMS\Axyne"
            CreateDirectory "$SMPROGRAMS\Axyne"
        ${EndIf}
        Push "$SMPROGRAMS\Axyne\Axyne.lnk"
        Call AxyneBeforeWrite
        CreateShortcut "$SMPROGRAMS\Axyne\Axyne.lnk" "$INSTDIR\axyne.exe"
    ${EndIf}
    ${If} $AxyneDesktop == 1
        Push "$DESKTOP\Axyne.lnk"
        Call AxyneBeforeWrite
        CreateShortcut "$DESKTOP\Axyne.lnk" "$INSTDIR\axyne.exe"
    ${EndIf}
    Push "$INSTDIR\Uninstall-Backend.exe"
    Call AxyneBeforeWrite
    WriteUninstaller "$INSTDIR\Uninstall-Backend.exe"
    !insertmacro AxyneFile "@CMAKE_CURRENT_BINARY_DIR@\Axyne-Uninstaller.exe" "Uninstall.exe"

    ClearErrors
    EnumRegValue $R1 SHCTX "${AXYNE_UNINSTALL_KEY}" 0
    ${If} ${Errors}
        !insertmacro AxyneJournal "K"
    ${EndIf}
    !insertmacro AxyneRegValue "DisplayName" "Axyne"
    !insertmacro AxyneRegValue "DisplayVersion" "@PROJECT_VERSION@"
    !insertmacro AxyneRegValue "InstallLocation" "$INSTDIR"
    !insertmacro AxyneRegValue "UninstallString" "$\"$INSTDIR\Uninstall.exe$\" $AxyneScopeArg"
SectionEnd

; The uninstaller UI copies Uninstall-Backend.exe to %TEMP% and runs it as
;   /S [/ALLUSERS] _?=<install dir>
; so this process can delete everything in $INSTDIR, including the UI.
Function un.onInit
    SetRegView 64
    ${GetParameters} $R0
    ClearErrors
    ${GetOptions} $R0 "/ALLUSERS" $R1
    ${IfNot} ${Errors}
        SetShellVarContext all
    ${EndIf}
FunctionEnd

Section "Uninstall"
    Delete "$SMPROGRAMS\Axyne\Axyne.lnk"
    RMDir "$SMPROGRAMS\Axyne"
    Delete "$DESKTOP\Axyne.lnk"
    Delete "$INSTDIR\*.*"
    Delete "$INSTDIR\.axyne-backup\*.*"
    RMDir "$INSTDIR\.axyne-backup"
    DeleteRegKey SHCTX "${AXYNE_UNINSTALL_KEY}"
    RMDir "$INSTDIR"
SectionEnd
